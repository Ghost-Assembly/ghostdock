# Copy to .env for local development. Never commit .env.

# Where GhostDock stores its database and materialised stack project dirs.
GHOSTDOCK_DATA_DIR=/var/lib/ghostdock

# Docker daemon socket.
DOCKER_HOST=unix:///var/run/docker.sock

# Listen address.
GHOSTDOCK_BIND=0.0.0.0:8080

# Encryption key for secrets at rest. If unset, GhostDock generates a 0600
# keyfile under GHOSTDOCK_DATA_DIR on first run.
# GHOSTDOCK_SECRET_KEY=
